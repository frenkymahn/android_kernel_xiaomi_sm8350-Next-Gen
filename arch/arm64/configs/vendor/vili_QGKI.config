# Fingerprint (Fixed duplicate symbol conflict)
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TEE=y
# CONFIG_FINGERPRINT_GOODIX_TA is not set

# Haptics
CONFIG_INPUT_AW8697_HAPTIC=y

# Power Supply
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_VILI_FOR_BUILD=y

# Proximity
CONFIG_MIUS_PROXIMITY=y

# Touchscreen
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHKEY=y

# stmvl53l5
CONFIG_STMVL53L5=y

# WiFi
CONFIG_CNSS_QCA6490=y

# HyperOS / MIUI Filesystem & Init Support
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y

# HyperOS Display & Android Security (No Timeout Loop)
CONFIG_BPF_SYSCALL=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y

# KernelSU Support
CONFIG_KSU=y
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBE_EVENTS=y

# Xiaomi Fast Charge & Thermal
CONFIG_XIAOMI_FASTCHARGE=y
CONFIG_MI_THERMAL=y

# Android 16/17 HyperOS Security & Namespace (Prevents Bootloop)
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y

# Modern Android Binder & Memory Tuning
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ASHMEM=y
CONFIG_MEMCG=y

# HyperOS Dynamic Partition & Crypto Support
CONFIG_DM_BOW=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y

# Xiaomi Display & Touch HAL node access
CONFIG_TOUCHSCREEN_COMMON=y

# Memory Management (ZRAM / PSI for HyperOS UI smoothness)
CONFIG_PSI=y
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y

# Xiaomi Proprietary Camera & Sensor Nodes (Fixes Camera Black Screen/Crash)
CONFIG_SPECTRA_CAMERA=y
CONFIG_MSM_CAMERA=y
CONFIG_MSM_CAMERA_SENSOR=y
CONFIG_SENSORS_SSC=y

# HyperOS Display & Refresh Rate Switch (Fixes Blank Screen / 120Hz Lag)
CONFIG_FB_MSM=y

# Xiaomi Audio Engine (Fixes No Sound / Call Audio Bug)
CONFIG_SND_SOC_SM8350=y
CONFIG_SND_SOC_WCD938X=y

# Android Binder 64-bit & Modern Security (Prevents Bootloop at HyperOS Logo)
CONFIG_ANDROID_BINDER_IPC_32BIT=n
CONFIG_SECURITY_NETWORK_XFRM=y

# HyperOS SELinux Permissive/Safety (Prevents Logo Freeze/Reboot)
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y

# Xiaomi Display & Framebuffer Nodes
CONFIG_QCOM_MDSS_PLL=y

# Xiaomi Dynamic CPU/Devfreq
CONFIG_ARM_QCOM_DEVFREQ_FW=y
CONFIG_DEVFREQ_GOV_QCOM_BW_HWMON=y

# Xiaomi Display Notifier for Touchscreen (Fixes undefined symbol mi_disp_register_client)
CONFIG_MI_DISP=y
CONFIG_MSM_SDE_POWER_HANDLE=y

# Disable duplicate DRM driver to prevent adreno clash
# CONFIG_DRM_MSM is not set
