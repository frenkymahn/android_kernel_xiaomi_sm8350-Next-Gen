# Fingerprint
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_FINGERPRINT_GOODIX_TEE=y

# Haptics
CONFIG_INPUT_AW8697_HAPTIC=y

# Power Supply
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_VILI_FOR_BUILD=y

# Proximity
CONFIG_MIUS_PROXIMITY=y

# Touchscreen
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHKEY=y

# stmvl53l5
CONFIG_STMVL53L5=y

# WiFi
CONFIG_CNSS_QCA6490=y

# HyperOS / MIUI Filesystem & Init Support
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y

# HyperOS Display & Android Security (No Timeout Loop)
CONFIG_MI_DISP=y
CONFIG_BPF_SYSCALL=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
