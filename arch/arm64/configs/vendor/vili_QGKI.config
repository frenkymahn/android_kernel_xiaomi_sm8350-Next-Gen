# Fingerprint
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TEE=y
# CONFIG_FINGERPRINT_GOODIX_TA is not set

# Haptics
CONFIG_INPUT_AW8697_HAPTIC=y

# Power Supply & Fast Charge
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_VILI_FOR_BUILD=y
CONFIG_XIAOMI_FASTCHARGE=y
CONFIG_MI_THERMAL=y

# Proximity & Sensors
CONFIG_MIUS_PROXIMITY=y
CONFIG_STMVL53L5=y
CONFIG_SENSORS_SSC=y

# Touchscreen & Gestures
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHKEY=y
CONFIG_TOUCHSCREEN_COMMON=y

# WiFi & Modem Identification
CONFIG_CNSS_QCA6490=y

# HyperOS / MIUI Filesystem & Storage
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_DM_BOW=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y

# Modern Android & eBPF Networking
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y

# KernelSU Support
CONFIG_KSU=y
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBE_EVENTS=y

# Android 14/15/16 HyperOS Namespaces & Security
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_NETWORK_XFRM=y

# HyperOS SELinux Permissive/Safety (Fixes Logo Freeze & Bootloop)
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y

# Modern Android Binder & Memory Tuning
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_IPC_32BIT=n
CONFIG_ASHMEM=y
CONFIG_MEMCG=y
CONFIG_PSI=y
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y

# Xiaomi Proprietary Camera & Sensors (Fixes Camera Black Screen/Crash)
CONFIG_SPECTRA_CAMERA=y
CONFIG_MSM_CAMERA=y
CONFIG_MSM_CAMERA_SENSOR=y

# Display & Refresh Rate (Fixes Blank Screen, 120Hz & Port Conflicts)
CONFIG_DRM_MSM=y
CONFIG_FB_MSM=y
CONFIG_QTI_GVM_QUIN_ARCH=n

# Xiaomi Audio Engine
CONFIG_SND_SOC_SM8350=y
CONFIG_SND_SOC_WCD938X=y
